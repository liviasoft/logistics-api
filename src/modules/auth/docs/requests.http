# Variables
@Authorization = Bearer {{token}}

# Developer Signup
POST {{baseUrl}}/api/v1/auth/developer/signup HTTP/1.1
Content-Type: application/json

{
    "email": "your@email.com",
    "password": "your password",
    "name": "Firstname Lastname"
}

###

# Developer Login
POST {{baseUrl}}/api/v1/auth/developer/login HTTP/1.1
Content-Type: application/json

{
    "email": "{{yourEmail}}",
    "password": "{{yourPassword}}"
}

###

# Developer Refresh Auth (when access Token expires
POST {{baseUrl}}/api/v1/auth/developer/refresh-token HTTP/1.1
Content-Type: application/json

{
  "userId": "your userId"
}

###

# View Developer profile
GET {{baseUrl}}/api/v1/auth/developer/me HTTP/1.1
Accept: application/json
Authorization: {{Authorization}}

