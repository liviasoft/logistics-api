// Prisma Schema - Minimal Template
// This schema provides a clean starting point with essential models only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Core Models
// =============================================================================

/// User account for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  active    Boolean  @default(true)

  // Localisation preferences stored as JSONB — one round-trip gives all preferences
  preferences Json?

  // Event sourcing metadata (optional, for CQRS patterns)
  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens        RefreshToken[]
  webhookSubscriptions WebhookSubscription[]
  payments             Payment[]
  notifications        Notification[]
  storedFiles          StoredFile[]
}

/// JWT refresh tokens for authentication
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// Feature flags for controlling feature availability
model FeatureFlag {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  enabled      Boolean @default(false)
  errorMessage String? @default("This feature is currently disabled")

  // Event sourcing metadata
  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Payments
// =============================================================================

/// Normalised record of a payment across any provider
model Payment {
  id                String  @id @default(cuid())
  /// Optional — some payments are anonymous (e.g. guest checkouts)
  userId            String?
  /// 'stripe' | 'adyen' | 'paystack'
  provider          String
  /// Provider's own payment ID (PaymentIntent ID, PSP reference, transaction ref…)
  providerPaymentId String
  /// Normalised status — see PaymentStatus in payments.types.ts
  status            String
  /// Smallest currency unit: cents (USD), pence (GBP), kobo (NGN), etc.
  amount            Int
  /// ISO 4217 currency code
  currency          String
  captureMethod     String  @default("automatic") // 'automatic' | 'manual'
  description       String?
  metadata          Json?
  /// Last raw response from the provider
  providerResponse  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([status])
}

/// Refund record — one per refund attempt
model Refund {
  id               String @id @default(cuid())
  paymentId        String
  provider         String
  providerRefundId String
  amount           Int
  currency         String
  status           String // 'pending' | 'succeeded' | 'failed'
  reason           String?
  providerResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerRefundId])
  @@index([paymentId])
}

// =============================================================================
// Webhooks
// =============================================================================

/// Outbound webhook subscription — a registered URL that receives events
model WebhookSubscription {
  id              String   @id @default(cuid())
  userId          String
  url             String
  events          String[] // e.g. ["user.created", "order.completed"]
  secret          String   // HMAC-SHA256 signing key (shown only at creation)
  description     String?
  active          Boolean  @default(true)
  suspended       Boolean  @default(false)
  suspendedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs WebhookDeliveryLog[]

  @@index([userId])
}

/// One record per delivery attempt for an outbound webhook
model WebhookDeliveryLog {
  id             String    @id @default(cuid())
  subscriptionId String
  event          String
  payload        Json
  status         String    // 'success' | 'failed'
  statusCode     Int?
  responseBody   String?   // truncated to 1 000 chars
  durationMs     Int?
  attemptNumber  Int       @default(1)
  error          String?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

/// Idempotency + audit record for every inbound webhook received
model InboundWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    // 'stripe' | 'github' | ...
  eventId     String    // provider's own unique event ID
  eventType   String    // e.g. 'payment_intent.succeeded'
  payload     Json
  status      String    @default("received") // 'received' | 'processing' | 'processed' | 'failed'
  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  @@unique([provider, eventId]) // prevents duplicate processing
  @@index([provider, status])
}

// =============================================================================
// Settings
// =============================================================================

/// Application settings — only DB overrides are stored here.
/// Missing keys fall back to coded defaults in settings.config.ts.
model Setting {
  /// Dot-notation key matching a key in AppSettings e.g. 'app.maintenanceMode'
  key       String   @id
  /// JSON value — type is enforced by SettingsService, not the DB
  value     Json
  /// ID of the user who last changed this setting (optional audit trail)
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Notifications
// =============================================================================

/// Record of every notification sent through any provider
model Notification {
  id                String    @id @default(cuid())
  userId            String?
  /// 'resend' | 'sendgrid' | 'twilio'
  provider          String
  /// 'email' | 'sms'
  channel           String
  /// Recipient email address or E.164 phone number
  to                String
  subject           String?
  status            String    @default("pending") // 'pending' | 'sent' | 'failed'
  providerMessageId String?
  error             String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([channel])
}

// =============================================================================
// File Storage
// =============================================================================

/// Record of every file uploaded through any storage provider
model StoredFile {
  id       String  @id @default(cuid())
  userId   String?
  /// 's3' | 'r2' | 'local'
  provider String
  /// Storage key / path within the bucket or upload directory
  key      String
  /// Public URL or last-generated signed URL
  url      String
  fileName String
  mimeType String?
  /// File size in bytes
  size     Int?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([key])
}

