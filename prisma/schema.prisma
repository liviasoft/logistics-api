// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  DEVELOPER
  READ_ONLY
}

enum OrgType {
  INDIVIDUAL
  COMPANY
}

model FeatureFlag {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  enabled      Boolean @default(false) // Global enable/disable
  errorMessage String? @default("This Feature is currently disabled")

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeveloperAccount {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientApps  ClientApp[]
  memberships OrganizationMember[]
}

model Organization {
  id   String  @id @default(cuid())
  name String
  type OrgType @default(INDIVIDUAL)

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    OrganizationMember[]
  clientApps ClientApp[]
}

model OrganizationMember {
  accountId      String
  organizationId String
  joinedAt       DateTime @default(now())

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  updatedAt DateTime @default(now()) @updatedAt

  role         OrgRole          @default(DEVELOPER)
  account      DeveloperAccount @relation(fields: [accountId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])

  @@id([organizationId, accountId])
}

model ClientApp {
  id             String @id @default(cuid())
  name           String
  developerId    String
  organizationId String
  clientId       String
  clientSecret   String

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers    ClientAppCustomer[]
  featureFlags ClientAppFeatureFlag[]
  orders       ClientAppOrder[]
  packages     ClientAppPackage[]

  developer    DeveloperAccount @relation(fields: [developerId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
}

model ClientAppFeatureFlag {
  id           String  @id @default(cuid())
  name         String  @unique
  clientAppId  String
  description  String?
  enabled      Boolean @default(false) // Global enable/disable
  errorMessage String? @default("This Feature is currently disabled")

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientApp ClientApp @relation(fields: [clientAppId], references: [id], onDelete: Cascade)
}

model ClientAppRole {
  role         String    @id @unique
  description  String
  isDefault    Boolean   @default(false) @db.Boolean
  requiresAuth Boolean   @default(false) @db.Boolean
  active       Boolean   @default(true) @db.Boolean
  created      DateTime  @default(now())
  updated      DateTime? @updatedAt

  permissions ClientAppPermission[]
}

model ClientAppPermission {
  role      String
  resource  String
  create    Boolean   @default(false)
  readOwn   Boolean   @default(false)
  readAny   Boolean   @default(false)
  updateOwn Boolean   @default(false)
  updateAny Boolean   @default(false)
  deleteOwn Boolean   @default(false)
  deleteAny Boolean   @default(false)
  created   DateTime  @default(now())
  updated   DateTime? @updatedAt

  roleData ClientAppRole @relation(fields: [role], references: [role], onDelete: Cascade)

  @@id([role, resource])
}

model ClientAppCustomer {
  id          String @id @default(cuid())
  clientAppId String
  firstname   String
  lastname    String
  email       String
  password    String

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientApp      ClientApp        @relation(fields: [clientAppId], references: [id], onDelete: Cascade)
  clientAppOrder ClientAppOrder[]

  @@unique([clientAppId, id])
  @@unique([clientAppId, email])
}

model ClientAppPackage {
  id          String @id @default(cuid())
  orderId     String
  description String
  clientAppId String

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientApp ClientApp @relation(fields: [clientAppId], references: [id], onDelete: Cascade)
}

model ClientAppOrder {
  id          String @id @default(cuid())
  clientAppId String
  customerId  String

  revision      Int?    @default(0) @db.Integer
  lastEventId   String?
  lastEventType String?
  lastStreamId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientApp ClientApp         @relation(fields: [clientAppId], references: [id], onDelete: Cascade)
  customer  ClientAppCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([clientAppId, id])
}

model RefreshToken {
  token     String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
